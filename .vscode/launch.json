{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Реактив: запустить .NET",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/bin/Debug/net10.0/Grenade.dll",
      "cwd": "${workspaceFolder}",
      "env": { "ASPNETCORE_URLS": "http://localhost:5186", "ASPNETCORE_ENVIRONMENT": "Development" },
      "serverReadyAction": { "action": "openExternally", "pattern": "\\bNow listening on:\\s+(https?://\\S+)" }
    }
  ]
}
