  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.12"
  },
  "dependencies": {
    "@fontsource-variable/golos-text": "^5.3.0",
    "@fontsource/prata": "^5.3.0"
